{
  "name": "conduit",
  "main": "src/entrypoint",
  "version": "2.2.0",
  "scripts": {
    "android": "npm run get-git-hash && expo run:android",
    "ios": "npm run get-git-hash && expo run:ios",
    "web": "npm run get-git-hash && expo start --web",
    "build:web": "npm run get-git-hash && expo export --platform web --output-dir dist",
    "get-git-hash": "node scripts/write-git-hash.js",
    "build-release": "npm run get-git-hash && cd android && NODE_ENV=production ./gradlew assembleRelease && cd ..",
    "perf:build:android": "bash scripts/perf-build-android.sh",
    "perf:build:android:mock": "PERF_MOCK=1 PERF_APK_OUT=conduit-perf-mock.apk bash scripts/perf-build-android.sh",
    "perf:build:android:stress": "PERF_MOCK=1 PERF_STRESS_SCENE=1 PERF_APK_OUT=conduit-perf-stress.apk bash scripts/perf-build-android.sh",
    "perf:run:android": "node scripts/perf-run-android.mjs",
    "release:cut": "node scripts/cut-release.js",
    "pretest": "npm run get-git-hash",
    "test": "jest --verbose",
    "format": "node scripts/convert-to-absolute-imports.js && prettier --write ./src",
    "pretsc": "npm run get-git-hash",
    "tsc": "tsc --noUnusedLocals --noUnusedParameters",
    "check": "npm run get-git-hash && node scripts/generate-worldmap-bounds.mjs --check && node scripts/generate-orb-assets.mjs --check && jest && prettier --check ./src && tsc --noUnusedLocals --noUnusedParameters",
    "generate:worldmap-bounds": "node scripts/generate-worldmap-bounds.mjs",
    "generate:orb-assets": "node scripts/generate-orb-assets.mjs",
    "dev-server": "expo start",
    "visual:serve": "npm run get-git-hash && expo start --port 8090",
    "visual:capture-native": "node visual/capture.mjs --renderer=native",
    "visual:compare": "node visual/compare.mjs",
    "visual:update-baselines": "node visual/capture.mjs --renderer=native --out=baselines",
    "visual:perf": "node visual/perf.mjs",
    "perf:android": "node scripts/perf-android.mjs",
    "perf:reset": "node scripts/perf-android.mjs --reset",
    "perf:report": "node scripts/perf-android.mjs",
    "perf:session": "node scripts/perf-android.mjs --session",
    "e2e:build:android:real": "scripts/e2e-build.sh android-real",
    "e2e:build:android:mock": "scripts/e2e-build.sh android-mock",
    "e2e:build:ios": "scripts/e2e-build.sh ios",
    "e2e": "maestro test maestro",
    "e2e:smoke": "maestro test maestro --include-tags=smoke --exclude-tags=oauth",
    "e2e:smoke:safe:android": "scripts/e2e-local.sh smoke-safe-android",
    "e2e:smoke:safe:ios": "scripts/e2e-local.sh smoke-safe-ios",
    "e2e:safe": "maestro test maestro --exclude-tags=destructive --exclude-tags=requires-hosted-state --exclude-tags=oauth",
    "e2e:safe:android": "scripts/e2e-local.sh safe-android",
    "e2e:safe:ios": "scripts/e2e-local.sh safe-ios",
    "e2e:cloud": "scripts/e2e-cloud.sh",
    "dev:up": "scripts/dev-sim.sh up",
    "dev:doctor": "scripts/dev-sim.sh doctor",
    "dev:rebuild": "scripts/dev-sim.sh rebuild",
    "dev:relaunch": "scripts/dev-sim.sh relaunch",
    "dev:test": "scripts/dev-sim.sh test",
    "dev:logs": "scripts/dev-sim.sh logs -f",
    "dev:down": "scripts/dev-sim.sh down",
    "watch:orb-assets": "node scripts/watch-orb-assets.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@noble/hashes|@noble/curves|@scure/bip39|@scure/base)"
    ],
    "moduleNameMapper": {
      "micro-key-producer/src/slip10": "micro-key-producer/slip10.js"
    },
    "setupFiles": [
      "./src/jestSetup.js"
    ]
  },
  "prettier": {
    "tabWidth": 4,
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "<THIRD_PARTY_MODULES>",
      "^@/src/(.*)$",
      "^[./]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "importOrderParserPlugins": [
      "typescript",
      "jsx",
      "decorators-legacy"
    ]
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.22",
    "@noble/curves": "^1.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/cli": "^19.1.1",
    "@react-navigation/native": "^7.0.14",
    "@revenuecat/purchases-js": "^1.33.0",
    "@scure/base": "^1.1.8",
    "@scure/bip39": "^1.4.0",
    "@tanstack/react-query": "^5.83.0",
    "expo": "^54.0.0",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.11",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-psiphon-tunnel-core": "file:./modules/expo-psiphon-tunnel-core",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-standard-web-crypto": "2.0.1",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "i18next": "^23.15.1",
    "micro-key-producer": "^0.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.0.2",
    "react-native": "0.81.5",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-purchases": "^9.7.6",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "expo-standard-web-crypto": {
      "expo-crypto": "$expo-crypto"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~54.0.12",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.17",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "prettier": "3.6.2",
    "react-test-renderer": "19.1.0",
    "svg-path-bounds": "^1.0.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
